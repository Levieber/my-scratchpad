# Server
# Railway sets PORT (and that switches the bind host to 0.0.0.0); locally PAD_PORT defaults to 7777.
PAD_PORT=7777
# Where the SQLite database lives. On Railway this is the volume: /data/pad.db
PAD_DB=
# Required whenever the server is reachable beyond localhost. Generate: openssl rand -hex 32
PAD_TOKEN=

# Clients (pad CLI, MCP server, SessionStart hook). Prefer `pad login <url> <token>` over these.
PAD_URL=
PAD_AUTHOR=
