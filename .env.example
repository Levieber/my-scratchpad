# Server
# Railway sets PORT (and that switches the bind host to 0.0.0.0); locally PAD_PORT defaults to 7777.
PAD_PORT=7777
# Where the SQLite database lives. On Railway this is the volume: /data/pad.db
PAD_DB=
# Required whenever the server is reachable beyond localhost. Generate: openssl rand -hex 32
PAD_TOKEN=
# The most one import may send, in bytes (default 64 MiB). Clients read it from GET /api/import.
# PAD_MAX_IMPORT_BYTES=67108864

# Clients (pad CLI, MCP server, SessionStart hook). Prefer `pad login <url> <token>` over these.
PAD_URL=
PAD_AUTHOR=

# MCP over HTTP (src/mcp-http.ts, claude.ai's connectors): PAD_URL and PAD_TOKEN above say which API
# it calls. Locally it listens on 7778 (PORT wins on a platform).
# PAD_MCP_PORT=7778
# The origin claude.ai reaches it at; on Railway it defaults to https://$RAILWAY_PUBLIC_DOMAIN.
PAD_MCP_URL=
# Signs the connectors' tokens; derived from PAD_TOKEN when empty. Generate: openssl rand -hex 32
PAD_OAUTH_SECRET=
