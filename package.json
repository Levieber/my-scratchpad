{
  "name": "my-scratchpad",
  "version": "0.1.0",
  "private": true,
  "description": "API-first scratchpad shared by a person and their AI agents",
  "license": "MIT",
  "repository": "github:Levieber/my-scratchpad",
  "bin": {
    "pad": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "NODE_ENV=production bun src/server.ts",
    "build": "bun build src/web/index.html --production --outdir=dist",
    "mcp": "bun src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bun run --parallel \"lint:check:*\"",
    "lint:check:quality": "oxlint --disable-nested-config",
    "lint:check:styles": "oxfmt --check",
    "lint:check:deps": "knip-bun",
    "lint:fix": "bun run --parallel \"lint:fix:*\"",
    "lint:fix:quality": "oxlint --disable-nested-config --fix",
    "lint:fix:styles": "oxfmt",
    "test": "bun test",
    "setup:claude": "bun integrations/claude-code/install.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "@effect/sql-sqlite-bun": "4.0.0",
    "effect": "4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "knip": "6.37.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2"
  }
}
